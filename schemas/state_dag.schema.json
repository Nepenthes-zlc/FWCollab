{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fwcollab.local/schemas/state_dag.schema.json",
  "title": "FWCollab state-predicate dependency DAG",
  "description": "A human-readable and machine-comparable DAG. Display text and identifier spelling do not participate in comparison.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "id",
    "difficulty",
    "evaluation_role",
    "visibility",
    "title",
    "summary",
    "topology_family",
    "mechanisms",
    "nodes",
    "edges"
  ],
  "properties": {
    "format": { "const": "fwcollab.symbolic.state_dag.v1" },
    "id": { "type": "string", "minLength": 1 },
    "difficulty": { "enum": ["L1", "L2", "L3", "L4", "L5", "L6", "L7"] },
    "evaluation_role": { "enum": ["diagnostic", "scored"] },
    "visibility": { "enum": ["private_reference", "agent_candidate", "public_example"] },
    "title": { "type": "string", "minLength": 1 },
    "summary": { "type": "string", "minLength": 1 },
    "topology_family": { "type": "string", "minLength": 1 },
    "mechanisms": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^M(?:0[1-9]|[12][0-9]|30)$" }
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/node" }
    },
    "edges": {
      "type": "array",
      "items": { "$ref": "#/$defs/edge" }
    }
  },
  "$defs": {
    "predicate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "motif", "state", "phase"],
      "properties": {
        "op": { "type": "string", "minLength": 1 },
        "motif": {
          "oneOf": [
            { "const": "SYSTEM" },
            { "type": "string", "pattern": "^M(?:0[1-9]|[12][0-9]|30)$" }
          ]
        },
        "state": { "type": "string", "minLength": 1 },
        "phase": { "type": "integer", "minimum": 0 }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "owner", "join", "predicate", "label"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["condition", "state", "event", "goal"] },
        "owner": { "enum": ["agent_a", "agent_b", "team", "environment"] },
        "join": { "enum": ["all", "any"] },
        "predicate": { "$ref": "#/$defs/predicate" },
        "label": { "type": "string", "minLength": 1 }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to", "relation"],
      "properties": {
        "from": { "type": "string", "minLength": 1 },
        "to": { "type": "string", "minLength": 1 },
        "relation": { "enum": ["requires", "enables", "maintains", "handoff", "synchronizes"] }
      }
    }
  }
}
