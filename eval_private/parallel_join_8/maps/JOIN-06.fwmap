@format fwcollab.symbol_map.v3
@id JOIN-06
@title join_then_maintain_F_to_W
@max_steps 1
@controller branch_f lever at 1,3
@controller branch_w toggle at 3,4
@actuator join_gate door at 1,10;3,10 controlled_by all(branch_f,branch_w)
@controller final_hold plate at 1,14 accepts F
@actuator final_gate door at 3,15 controlled_by all(final_hold)
---
