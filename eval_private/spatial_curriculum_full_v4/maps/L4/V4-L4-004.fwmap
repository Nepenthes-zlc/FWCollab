@format fwcollab.symbol_map.v3
@id V4-L4-004
@title constructive L4 full-mechanism curriculum 004; rotatable-mirror orb light door
@max_steps 1
@controller c1_toggle toggle at 6,5
@controller c2_plate plate at 8,6 accepts W
@actuator a1_platform platform at 2,9 controlled_by all(c1_toggle,c2_plate)
@controller c3_toggle toggle at 3,14
@actuator a2_door door at 7,18 controlled_by all(c3_toggle)
@controller c4_toggle toggle at 6,23
@actuator a3_platform platform at 2,27 controlled_by all(c4_toggle)
@controller c5_plate plate at 3,32 accepts F
@actuator a4_platform platform at 7,36 controlled_by all(c5_plate)
@light + direction RIGHT sensor S opens A
@controller cap_mirror_toggle toggle at 3,50
@mirror M initial slash controlled_by cap_mirror_toggle
