@format fwcollab.symbol_map.v3
@id V4-L4-003
@title constructive L4 full-mechanism curriculum 003; rotatable-mirror crate light door
@max_steps 1
@controller c1_plate plate at 3,5 accepts F
@actuator a1_door door at 7,9 controlled_by all(c1_plate)
@controller c2_plate plate at 6,14 accepts W
@actuator a2_platform platform at 2,18 controlled_by all(c2_plate)
@controller c3_lever lever at 3,23
@controller c4_lever lever at 1,24
@actuator a3_door door at 7,27 controlled_by all(c3_lever,c4_lever)
@controller c5_toggle toggle at 6,32
@actuator a4_platform platform at 2,36 controlled_by all(c5_toggle)
@light + direction RIGHT sensor S opens A
@controller cap_mirror_toggle toggle at 3,50
@mirror M initial slash controlled_by cap_mirror_toggle
