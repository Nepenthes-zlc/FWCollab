@format fwcollab.symbol_map.v3
@id V4-L4-010
@title constructive L4 full-mechanism curriculum 010; orb-cleared light door
@max_steps 1
@controller c1_toggle toggle at 6,5
@controller c2_plate plate at 8,6 accepts W
@actuator a1_platform platform at 2,9 controlled_by all(c1_toggle,c2_plate)
@controller c3_lever lever at 3,14
@actuator a2_door door at 7,18 controlled_by all(c3_lever)
@controller c4_toggle toggle at 6,23
@actuator a3_platform platform at 2,27 controlled_by all(c4_toggle)
@controller c5_lever lever at 3,32
@actuator a4_door door at 7,36 controlled_by all(c5_lever)
@light + direction RIGHT sensor S opens A
