@format fwcollab.symbol_map.v3
@id V4-L2-006
@title constructive L2 full-mechanism curriculum 006; orb-held plate door
@max_steps 1
@controller c1_toggle toggle at 6,5
@controller c2_plate plate at 8,6 accepts W
@actuator a1_platform platform at 2,9 controlled_by all(c1_toggle,c2_plate)
@controller c3_plate plate at 3,14 accepts F
@actuator a2_door door at 7,18 controlled_by all(c3_plate)
@controller cap_heavy_plate plate at 2,34 accepts O
@actuator cap_door door at 7,38 controlled_by all(cap_heavy_plate)
