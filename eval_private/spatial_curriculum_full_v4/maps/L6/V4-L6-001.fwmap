@format fwcollab.symbol_map.v3
@id V4-L6-001
@title constructive L6 full-mechanism curriculum 001; crate-held plate bridge
@max_steps 1
@controller c1_plate plate at 3,5 accepts F
@actuator a1_door door at 7,9 controlled_by all(c1_plate)
@controller c2_toggle toggle at 6,14
@controller c3_plate plate at 8,15 accepts W
@actuator a2_platform platform at 2,18 controlled_by all(c2_toggle,c3_plate)
@controller c4_plate plate at 3,23 accepts F
@actuator a3_door door at 7,27 controlled_by all(c4_plate)
@controller c5_toggle toggle at 6,32
@controller c6_plate plate at 8,33 accepts W
@actuator a4_platform platform at 2,36 controlled_by all(c5_toggle,c6_plate)
@controller c7_lever lever at 3,41
@controller c8_lever lever at 1,42
@actuator a5_door door at 7,45 controlled_by all(c7_lever,c8_lever)
@controller c9_toggle toggle at 6,50
@actuator a6_platform platform at 2,54 controlled_by all(c9_toggle)
@controller cap_heavy_plate plate at 2,69 accepts O
@actuator cap_platform platform at 7,74 controlled_by all(cap_heavy_plate)
