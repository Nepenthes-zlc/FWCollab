@format fwcollab.symbol_map.v3
@id V4-L6-012
@title constructive L6 full-mechanism curriculum 012; mandatory rolling orb displacement
@max_steps 1
@controller c1_lever lever at 6,5
@actuator a1_platform platform at 2,9 controlled_by all(c1_lever)
@controller c2_plate plate at 3,14 accepts F
@actuator a2_platform platform at 7,18 controlled_by all(c2_plate)
@controller c3_toggle toggle at 6,23
@actuator a3_platform platform at 2,27 controlled_by all(c3_toggle)
@controller c4_plate plate at 3,32 accepts F
@actuator a4_door door at 7,36 controlled_by all(c4_plate)
@controller c5_plate plate at 6,41 accepts W
@actuator a5_door door at 2,45 controlled_by all(c5_plate)
@controller c6_toggle toggle at 3,50
@actuator a6_door door at 7,54 controlled_by all(c6_toggle)
