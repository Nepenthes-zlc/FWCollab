@format fwcollab.symbol_map.v3
@id V4-L6-006
@title constructive L6 full-mechanism curriculum 006; fixed-reflection crate light door
@max_steps 1
@controller c1_lever lever at 6,5
@actuator a1_platform platform at 2,9 controlled_by all(c1_lever)
@controller c2_lever lever at 3,14
@controller c3_lever lever at 1,15
@actuator a2_door door at 7,18 controlled_by all(c2_lever,c3_lever)
@controller c4_toggle toggle at 6,23
@actuator a3_platform platform at 2,27 controlled_by all(c4_toggle)
@controller c5_toggle toggle at 3,32
@actuator a4_door door at 7,36 controlled_by all(c5_toggle)
@controller c6_toggle toggle at 6,41
@controller c7_plate plate at 8,42 accepts W
@actuator a5_platform platform at 2,45 controlled_by all(c6_toggle,c7_plate)
@controller c8_lever lever at 3,50
@actuator a6_door door at 7,54 controlled_by all(c8_lever)
@light + direction RIGHT sensor S opens A
