@format fwcollab.symbol_map.v3
@id V4-L7-004
@title constructive L7 full-mechanism curriculum 004; fixed-reflection orb light door
@max_steps 1
@controller c1_toggle toggle at 8,5
@actuator a1_platform platform at 2,9 controlled_by all(c1_toggle)
@controller c2_lever lever at 1,14
@controller c3_plate plate at 3,15 accepts F
@actuator a2_door door at 7,18 controlled_by all(c2_lever,c3_plate)
@controller c4_toggle toggle at 8,23
@controller c5_plate plate at 6,24 accepts W
@actuator a3_platform platform at 2,27 controlled_by all(c4_toggle,c5_plate)
@controller c6_lever lever at 1,32
@controller c7_plate plate at 3,33 accepts F
@actuator a4_door door at 7,36 controlled_by all(c6_lever,c7_plate)
@controller c8_lever lever at 8,41
@actuator a5_platform platform at 2,45 controlled_by all(c8_lever)
@controller c9_lever lever at 1,50
@actuator a6_door door at 7,54 controlled_by all(c9_lever)
@controller c10_lever lever at 8,59
@controller c11_lever lever at 6,60
@actuator a7_door door at 2,63 controlled_by any(c10_lever,c11_lever)
@light + direction RIGHT sensor S opens A
---
