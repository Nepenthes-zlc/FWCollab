@format fwcollab.symbol_map.v3
@id V4-L5-005
@title constructive L5 full-mechanism curriculum 005; mandatory rolling orb displacement
@max_steps 1
@controller c1_plate plate at 1,5 accepts F
@actuator a1_platform platform at 7,9 controlled_by all(c1_plate)
@controller c2_plate plate at 8,14 accepts W
@actuator a2_platform platform at 2,18 controlled_by all(c2_plate)
@controller c3_lever lever at 1,23
@controller c4_plate plate at 3,24 accepts F
@actuator a3_door door at 7,27 controlled_by all(c3_lever,c4_plate)
@controller c5_toggle toggle at 8,32
@actuator a4_platform platform at 2,36 controlled_by all(c5_toggle)
@controller c6_toggle toggle at 1,41
@actuator a5_door door at 7,45 controlled_by all(c6_toggle)
