@format fwcollab.symbol_map.v3
@id V4-L5-001
@title constructive L5 full-mechanism curriculum 001; water affinity crossing
@max_steps 1
@controller c1_lever lever at 1,5
@actuator a1_door door at 7,9 controlled_by all(c1_lever)
@controller c2_lever lever at 8,14
@controller c3_lever lever at 6,15
@actuator a2_door door at 2,18 controlled_by any(c2_lever,c3_lever)
@controller c4_lever lever at 1,23
@actuator a3_door door at 7,27 controlled_by all(c4_lever)
@controller c5_plate plate at 8,32 accepts W
@actuator a4_door door at 2,36 controlled_by all(c5_plate)
@controller c6_toggle toggle at 1,41
@actuator a5_door door at 7,45 controlled_by all(c6_toggle)
