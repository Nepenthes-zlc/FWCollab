@format fwcollab.symbol_map.v3
@id V4-L5-007
@title constructive L5 full-mechanism curriculum 007; mandatory paired portal
@max_steps 1
@controller c1_lever lever at 1,5
@actuator a1_door door at 7,9 controlled_by all(c1_lever)
@controller c2_plate plate at 8,14 accepts W
@actuator a2_platform platform at 2,18 controlled_by all(c2_plate)
@controller c3_lever lever at 1,23
@actuator a3_door door at 7,27 controlled_by all(c3_lever)
@controller c4_lever lever at 8,32
@controller c5_lever lever at 6,33
@actuator a4_door door at 2,36 controlled_by any(c4_lever,c5_lever)
@controller c6_toggle toggle at 1,41
@actuator a5_door door at 7,45 controlled_by all(c6_toggle)
@portal P
