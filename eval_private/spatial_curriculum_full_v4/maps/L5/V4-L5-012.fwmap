@format fwcollab.symbol_map.v3
@id V4-L5-012
@title constructive L5 full-mechanism curriculum 012; fixed-reflection orb light door
@max_steps 1
@controller c1_toggle toggle at 8,5
@actuator a1_platform platform at 2,9 controlled_by all(c1_toggle)
@controller c2_toggle toggle at 1,14
@actuator a2_door door at 7,18 controlled_by all(c2_toggle)
@controller c3_plate plate at 8,23 accepts W
@actuator a3_platform platform at 2,27 controlled_by all(c3_plate)
@controller c4_lever lever at 1,32
@actuator a4_door door at 7,36 controlled_by all(c4_lever)
@controller c5_plate plate at 8,41 accepts W
@actuator a5_platform platform at 2,45 controlled_by all(c5_plate)
@light + direction RIGHT sensor S opens A
