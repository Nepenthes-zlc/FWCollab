@format fwcollab.symbol_map.v3
@id SYNC-08
@title enable_F_to_W_then_sync_K3
@max_steps 1
@controller prefix_controller lever at 1,3
@actuator prefix_gate door at 3,6 controlled_by all(prefix_controller)
@controller sync_f plate at 1,10 accepts F
@controller sync_w plate at 3,10 accepts W
@actuator sync_gate door at 1,11;3,11 controlled_by all(sync_f,sync_w)
