@format fwcollab.symbol_map.v3
@id HG-008
@title held-out layout paired with V4-L5-004; mandatory crate displacement
@max_steps 1
@controller c1_lever lever at 6,5
@controller c2_lever lever at 8,6
@actuator a1_door door at 2,9 controlled_by any(c1_lever,c2_lever)
@controller c3_plate plate at 3,14 accepts F
@actuator a2_platform platform at 7,18 controlled_by all(c3_plate)
@controller c4_lever lever at 6,23
@actuator a3_platform platform at 2,27 controlled_by all(c4_lever)
@controller c5_toggle toggle at 3,32
@actuator a4_door door at 7,36 controlled_by all(c5_toggle)
@controller c6_toggle toggle at 6,41
@actuator a5_platform platform at 2,45 controlled_by all(c6_toggle)
