@format fwcollab.symbol_map.v3
@id HG-003
@title held-out layout paired with V4-L3-010; mandatory paired portal
@max_steps 1
@controller c1_plate plate at 6,5 accepts W
@actuator a1_door door at 2,9 controlled_by all(c1_plate)
@controller c2_lever lever at 3,14
@actuator a2_door door at 7,18 controlled_by all(c2_lever)
@controller c3_plate plate at 6,23 accepts W
@actuator a3_platform platform at 2,27 controlled_by all(c3_plate)
@portal P
